# ════════════════════════════════════════════════════════════════════════════
# Concept System shape (ISO 12620 A.7)
# ════════════════════════════════════════════════════════════════════════════

gloss:ConceptSystemShape a sh:NodeShape ;
  sh:targetClass gloss:ConceptSystem ;
  sh:property [
    sh:path gloss:hasSystemType ;
    sh:class skos:Concept ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( <https://www.glossarist.org/ontologies/conceptSystemType/generic> <https://www.glossarist.org/ontologies/conceptSystemType/partitive> <https://www.glossarist.org/ontologies/conceptSystemType/sequential> <https://www.glossarist.org/ontologies/conceptSystemType/associative> <https://www.glossarist.org/ontologies/conceptSystemType/mixed> ) ;
  ] ;
  # declared as ConceptRef historically; OWL range of gloss:hasMember is ConceptSystemMember — the OWL range is flagged for review (system members are concept references).
  sh:property [
    sh:path gloss:hasMember ;
    sh:class gloss:ConceptRef ;
    sh:minCount 1 ;
  ] ;
  # OWL range gloss:AbstractHyperedge is not declared as an owl:Class in glossarist.ttl — flagged for correction.
  sh:property [
    sh:path gloss:hasHyperedge ;
    sh:class gloss:AbstractHyperedge ;
  ] ;
  sh:property [
    sh:path gloss:hasRootConcept ;
    sh:class gloss:ConceptRef ;
  ] ;
  sh:property [
    sh:path gloss:hasSystemMember ;
    sh:class gloss:ConceptRef ;
  ] .

gloss:ConceptSystemTypeShape a sh:NodeShape ;
  sh:targetClass gloss:ConceptSystemType ;
  sh:property [
    sh:path skos:inScheme ;
    sh:minCount 1 ;
    sh:hasValue <https://www.glossarist.org/ontologies/conceptSystemType> ;
  ] .
# ════════════════════════════════════════════════════════════════════════════
# Partitive Relation shapes (ISO 704 / 1087-1 / 12620)
# ════════════════════════════════════════════════════════════════════════════

gloss:PartitiveRelationShape a sh:NodeShape ;
  sh:targetClass gloss:PartitiveRelation ;
  sh:property [
    sh:path gloss:comprehensive ;
    sh:class gloss:ConceptRef ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  # ISO 704: "two or more"
  sh:property [
    sh:path gloss:hasMember ;
    sh:class gloss:ConceptSystemMember ;
    sh:minCount 2 ;
  ] ;
  sh:property [
    sh:path gloss:completeness ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:valuesFrom <https://www.glossarist.org/ontologies/completeness> ;
  ] ;
  sh:property [
    sh:path gloss:criterion ;
    sh:datatype rdf:langString ;
  ] ;
  sh:property [
    sh:path gloss:hasPartitive ;
    sh:class gloss:PartitiveMember ;
  ] .

gloss:ConceptSystemMemberShape a sh:NodeShape ;
  sh:targetClass gloss:ConceptSystemMember ;
  sh:property [
    sh:path gloss:ref ;
    sh:class gloss:ConceptRef ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:presence ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:valuesFrom <https://www.glossarist.org/ontologies/partitivePresence> ;
  ] ;
  sh:property [
    sh:path gloss:count ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:valuesFrom <https://www.glossarist.org/ontologies/partitiveCount> ;
  ] ;
  sh:property [
    sh:path gloss:isDelimiting ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
  ] .

gloss:PartitiveMemberShape a sh:NodeShape ;
  sh:targetClass gloss:PartitiveMember ;
  # OWL rdfs:domain of gloss:ref is ConceptSystemMember; PartitiveMember specializes it.
  sh:property [
    sh:path gloss:ref ;
    sh:class gloss:ConceptRef ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] .

gloss:GenericRelationShape a sh:NodeShape ;
  sh:targetClass gloss:GenericRelation ;
  sh:property [
    sh:path gloss:comprehensive ;
    sh:class gloss:ConceptRef ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:hasMember ;
    sh:class gloss:ConceptSystemMember ;
    sh:minCount 2 ;
  ] ;
  sh:property [
    sh:path gloss:completeness ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:valuesFrom <https://www.glossarist.org/ontologies/completeness> ;
  ] ;
  # OWL rdfs:domain covers PartitiveRelation only; adding GenericRelation to the domain union is flagged for the ontology.
  sh:property [
    sh:path gloss:criterion ;
    sh:datatype rdf:langString ;
  ] ;
  sh:property [
    sh:path gloss:hasGeneric ;
    sh:class gloss:GenericMember ;
  ] .

gloss:GenericMemberShape a sh:NodeShape ;
  sh:targetClass gloss:GenericMember ;
  # OWL rdfs:domain of gloss:ref is ConceptSystemMember; GenericMember specializes it.
  sh:property [
    sh:path gloss:ref ;
    sh:class gloss:ConceptRef ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:characteristic ;
    sh:datatype rdf:langString ;
    sh:maxCount 1 ;
    sh:severity sh:Info ;
    rdfs:comment "ISO 704:2022 §5.5.4.2.1 delimiting characteristic. Recommended but not required; some datasets only carry the criterion on the rake, not the characteristic on each species."@en ;
  ] .

# Reject the vacuous combination presence=optional + count=at_least_one. Applies to all ConceptSystemMember subclasses (Partitive + Generic).
gloss:ConceptSystemMemberVacuousComboShape a sh:NodeShape ;
  sh:targetClass gloss:ConceptSystemMember ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "presence=optional + count=at_least_one is vacuous — use (optional, multiple) instead."@en ;
    sh:prefixes [
      sh:declare [ sh:prefix "gloss" ; sh:namespace "https://www.glossarist.org/ontologies/"^^xsd:anyURI ] ;
      sh:declare [ sh:prefix "partitivePresence" ; sh:namespace "https://www.glossarist.org/ontologies/partitivePresence/"^^xsd:anyURI ] ;
      sh:declare [ sh:prefix "partitiveCount" ; sh:namespace "https://www.glossarist.org/ontologies/partitiveCount/"^^xsd:anyURI ]
    ] ;
    sh:select
    """
      SELECT $this
      WHERE {
        $this gloss:presence <https://www.glossarist.org/ontologies/partitivePresence/optional> .
        $this gloss:count <https://www.glossarist.org/ontologies/partitiveCount/at_least_one> .
      }
    """
  ] .

# Standalone relation file shape — validates per-file format. Each file must have $id matching <comprehensive-id>/<criterion-slug> pattern, a valid type, comprehensive, and >= 2 members.
gloss:StandaloneRelationFileShape a sh:NodeShape ;
  sh:targetClass gloss:AbstractNaryRelation ;
  # not declared in glossarist.ttl.
  sh:property [
    sh:path gloss:relationFileType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "partitive_relation" "generic_relation" ) ;
  ] ;
  # OWL rdfs:domain covers PartitiveRelation and GenericRelation; AbstractNaryRelation is their common ancestor.
  sh:property [
    sh:path gloss:comprehensive ;
    sh:class gloss:ConceptRef ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:hasMember ;
    sh:class gloss:ConceptSystemMember ;
    sh:minCount 2 ;
  ] .
# not shaped: gloss:hasNote — concept-level notes are not serialized as RDF notes; OWL range (rdf:langString) diverges from the JSON-LD context's node reference.

# DetailedDefinition type — ISO 704:2022 §5.3 definition strategy.
gloss:DetailedDefinitionTypeShape a sh:NodeShape ;
  sh:targetClass gloss:DetailedDefinition ;
  sh:property [
    sh:path gloss:hasDefinitionType ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:valuesFrom <https://www.glossarist.org/ontologies/taxonomies/definition-type> ;
  ] .

# ExternalConcept coherence — an external concept (status: external) must NOT have a definition or sources; that would contradict its status. Soft warning to allow transitional data.
gloss:ExternalConceptCoherenceShape a sh:NodeShape ;
  sh:targetSubjectsOf gloss:hasStatus ;
  sh:severity sh:Warning ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An external concept should not have a definition — that contradicts status: external."@en ;
    sh:prefixes [
      sh:declare [ sh:prefix "gloss" ; sh:namespace "https://www.glossarist.org/ontologies/"^^xsd:anyURI ]
    ] ;
    sh:select
    """
      SELECT $this ?definition
      WHERE {
        $this gloss:hasStatus <https://www.glossarist.org/ontologies/status/external> .
        $this gloss:hasDefinition ?definition .
      }
    """
  ] .

# Ownership invariant — soft (warning severity). A PartitiveRelation is conventionally carried by its comprehensive's own concept entry. Datasets may legitimately cross-reference; we warn so reviewers can confirm the cross-reference is intentional.
gloss:PartitiveRelationOwnershipShape a sh:NodeShape ;
  sh:targetClass gloss:PartitiveRelation ;
  sh:severity sh:Warning ;
  sh:message "partitive_relation is carried by a concept that is not its comprehensive — confirm the cross-reference is intentional."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:prefixes [
      sh:declare [ sh:prefix "gloss" ; sh:namespace "https://www.glossarist.org/ontologies/"^^xsd:anyURI ] ;
      sh:declare [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ]
    ] ;
    sh:select
    """
      SELECT $this ?carryingConcept ?compRef
      WHERE {
        ?carryingConcept gloss:hasPartitiveRelation $this .
        $this gloss:comprehensive ?compRef .
        OPTIONAL { ?compRef gloss:conceptRefId ?literalId . }
        BIND(COALESCE(?literalId, STRAFTER(STR(?compRef), CONCAT(STR(?carryingConcept), "/"))) AS ?compKey)
        FILTER (BOUND(?compKey) && !STRENDS(STR(?carryingConcept), CONCAT("/", ?compKey)))
      }
    """
  ] .
# ════════════════════════════════════════════════════════════════════════════
# Non-verbal entity hierarchy
# ════════════════════════════════════════════════════════════════════════════

gloss:NonVerbalEntityShape a sh:NodeShape ;
  sh:targetClass gloss:NonVerbalEntity ;
  # declared here historically; OWL rdfs:domain union does not include NonVerbalEntity — flagged for addition to the ontology.
  sh:property [
    sh:path gloss:hasSource ;
    sh:class gloss:ConceptSource ;
  ] ;
  # OWL range is rdf:langString; the JSON-LD context types caption as xsd:string — shapes follow the context; OWL flagged for correction.
  sh:property [
    sh:path gloss:caption ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  # same caption divergence (OWL rdf:langString vs context xsd:string).
  sh:property [
    sh:path gloss:altText ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  # same caption divergence (OWL rdf:langString vs context xsd:string).
  sh:property [
    sh:path gloss:description ;
    sh:datatype xsd:string ;
  ] .

gloss:NonConceptEntityShape a sh:NodeShape ;
  sh:targetClass gloss:NonConceptEntity ;
  sh:class gloss:NonVerbalEntity ;
  # declared here historically; OWL rdfs:domain is FigureImage (where it is also derived).
  sh:property [
    sh:path gloss:role ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:urn ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 ;
  ] .

gloss:FigureImageShape a sh:NodeShape ;
  sh:targetClass gloss:FigureImage ;
  # declared here historically; OWL rdfs:domain is Figure (where it is also derived).
  sh:property [
    sh:path gloss:hasSubfigure ;
    sh:class gloss:FigureImage ;
  ] ;
  sh:property [
    sh:path gloss:format ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:role ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path gloss:src ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] .

gloss:GrammarInfoShape a sh:NodeShape ;
  sh:targetClass gloss:GrammarInfo ;
  sh:property [
    sh:path gloss:gender ;
    sh:class skos:Concept ;
    sh:valuesFrom <https://www.glossarist.org/ontologies/gender> ;
  ] ;
  sh:property [
    sh:path gloss:number ;
    sh:class skos:Concept ;
    sh:valuesFrom <https://www.glossarist.org/ontologies/number> ;
  ] ;
  sh:property [
    sh:path gloss:partOfSpeech ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:isAdjective ;
    sh:datatype xsd:boolean ;
  ] ;
  sh:property [
    sh:path gloss:isAdverb ;
    sh:datatype xsd:boolean ;
  ] ;
  sh:property [
    sh:path gloss:isNoun ;
    sh:datatype xsd:boolean ;
  ] ;
  sh:property [
    sh:path gloss:isParticiple ;
    sh:datatype xsd:boolean ;
  ] ;
  sh:property [
    sh:path gloss:isPreposition ;
    sh:datatype xsd:boolean ;
  ] ;
  sh:property [
    sh:path gloss:isVerb ;
    sh:datatype xsd:boolean ;
  ] .
# ════════════════════════════════════════════════════════════════════════════
# Dataset Register shapes
# ════════════════════════════════════════════════════════════════════════════

gloss:DatasetRegisterShape a sh:NodeShape ;
  sh:targetClass gloss:DatasetRegister ;
  sh:property [
    sh:path gloss:datasetId ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:datasetUrn ;
    sh:datatype xsd:anyURI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:datasetRef ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:datasetYear ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:datasetStatus ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:in ( "current" "superseded" "retired" ) ;
  ] ;
  sh:property [
    sh:path gloss:supersedesDataset ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:owner ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:sourceRepo ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:hasDefaultOrdering ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:valuesFrom <https://www.glossarist.org/ontologies/orderingmethod> ;
  ] ;
  sh:property [
    sh:path gloss:logo ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:aboutPath ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path gloss:datasetDescription ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path gloss:datasetLanguage ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path gloss:datasetRefAlias ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path gloss:datasetUrnAlias ;
    sh:datatype xsd:anyURI ;
  ] ;
  sh:property [
    sh:path gloss:hasSection ;
    sh:class gloss:Section ;
  ] ;
  sh:property [
    sh:path gloss:languageOrder ;
    sh:datatype xsd:string ;
  ] .

gloss:SectionShape a sh:NodeShape ;
  sh:targetClass gloss:Section ;
  sh:property [
    sh:path gloss:sectionId ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:hasParentSection ;
    sh:class gloss:Section ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path gloss:sectionOrdering ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:valuesFrom <https://www.glossarist.org/ontologies/orderingmethod> ;
  ] ;
  sh:property [
    sh:path gloss:hasChildSection ;
    sh:class gloss:Section ;
  ] ;
  sh:property [
    sh:path gloss:sectionName ;
    sh:datatype xsd:string ;
  ] .
