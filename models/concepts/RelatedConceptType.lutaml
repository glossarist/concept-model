enum RelatedConceptType {
  definition {
    The relation of a term to the current term, covering ISO 10241-1,
    ISO 25964/SKOS, ISO 12620/TBX, ISO 19135, and designation-level
    relationships. 52 relationship types in total.
  }

  // ── Lifecycle (ISO 10241-1 / ISO 19135) ───────────────────────────
  deprecates {
    definition {
      The current term deprecates the related term.
    }
  }
  deprecated_by {
    definition {
      The current term has been deprecated by another concept.
    }
  }
  supersedes {
    definition {
      The current term supersedes the related term.
    }
  }
  superseded_by {
    definition {
      The current term has been superseded by the related term.
    }
  }
  replaces {
    definition {
      The current term replaces the related term in a register (ISO 19135).
    }
  }
  replaced_by {
    definition {
      The current term has been replaced by the related term in a register.
    }
  }
  invalidates {
    definition {
      The current term invalidates the related term (ISO 19135).
    }
  }
  invalidated_by {
    definition {
      The current term has been invalidated by the related term.
    }
  }
  retires {
    definition {
      The current term retires the related term from a register (ISO 19135).
    }
  }
  retired_by {
    definition {
      The current term has been retired by the related term.
    }
  }

  // ── Hierarchical — Generic (ISO 25964 BTG/NTG) ───────────────────
  broader {
    definition {
      The current term is narrower in denotation than the related term.
    }
  }
  narrower {
    definition {
      The current term is broader in denotation than the related term.
    }
  }
  broader_generic {
    definition {
      The current term is a kind of the related term (generic/specific).
    }
  }
  narrower_generic {
    definition {
      The related term is a kind of the current term.
    }
  }

  // ── Hierarchical — Partitive (ISO 25964 / ISO 19135) ─────────────
  //
  // These are BINARY partitive edges. For one-to-many decompositions
  // where membership is jointly significant (a "rake"), or where
  // diagram notation (double / dashed) or open/closed completeness
  // applies, use PartitiveHyperedge instead — see
  // models/concepts/PartitiveHyperedge.lutaml. Both forms coexist;
  // choose deliberately per relationship.
  broader_partitive {
    definition {
      The current term is a part of the related term (whole/part).
    }
  }
  narrower_partitive {
    definition {
      The related term is a part of the current term.
    }
  }
  has_part {
    definition {
      The current concept has the related concept as a part (ISO 19135).
    }
  }
  is_part_of {
    definition {
      The current concept is a part of the related concept.
    }
  }

  // ── Hierarchical — Instantial (ISO 25964 / ISO 19135) ────────────
  broader_instantial {
    definition {
      The current term is an instance of the related term (class/instance).
    }
  }
  narrower_instantial {
    definition {
      The related term is an instance of the current term.
    }
  }
  instance_of {
    definition {
      The current concept is an instance of the related concept (ISO 19135).
    }
  }
  has_instance {
    definition {
      The current concept has the related concept as an instance.
    }
  }

  // ── Equivalence (ISO 10241-1 / ISO 25964 / SKOS) ────────────────
  equivalent {
    definition {
      The current term is equivalent in denotation to the related term.
    }
  }
  exact_match {
    definition {
      The current term is an exact cross-vocabulary match (SKOS skos:exactMatch).
    }
  }

  // ── SKOS Mapping Properties ──────────────────────────────────────
  close_match {
    definition {
      The current term is approximately equivalent to the related term.
    }
  }
  broad_match {
    definition {
      The current term has a broader match in another vocabulary.
    }
  }
  narrow_match {
    definition {
      The current term has a narrower match in another vocabulary.
    }
  }
  related_match {
    definition {
      The current term has a related match in another vocabulary.
    }
  }

  // ── Comparative (ISO 10241-1) ────────────────────────────────────
  compare {
    definition {
      The current term may be compared to the related term.
    }
  }
  contrast {
    definition {
      The current term is understood in contrast to the related term.
    }
  }

  // ── Associative (ISO 10241-1 / ISO 25964) ───────────────────────
  see {
    definition {
      Refer to the related term for the definition of the current term.
    }
  }
  references {
    definition {
      The current concept references the related concept.
    }
  }
  related_concept {
    definition {
      The related term is associated with the current term.
    }
  }
  related_concept_broader {
    definition {
      The related term is associated in a broader sense.
    }
  }
  related_concept_narrower {
    definition {
      The related term is associated in a narrower sense.
    }
  }

  // ── Spatiotemporal (ISO 25964 / TBX) ─────────────────────────────
  sequentially_related {
    definition {
      The related term is sequentially related to the current term.
    }
  }
  spatially_related {
    definition {
      The related term is spatially related to the current term.
    }
  }
  temporally_related {
    definition {
      The related term is temporally related to the current term.
    }
  }

  // ── Associative — contiguity (ISO 704:2022 §5.5.5 Table 1) ─────
  enhances {
    definition { tool – accessory (smartphone – selfie stick). }
  }
  enhanced_by {
    definition { accessory – tool (inverse of enhances). }
  }
  contains {
    definition { container – contained (milk carton – milk). }
  }
  contained_by_container {
    definition { contained – container (inverse of contains). }
  }
  contained_by_contained {
    definition { contained – contained relative to a shared container (fish – shellfish re: sea). }
  }
  attaches {
    definition { tool – connection (screen – HDMI port). }
  }
  attached_to {
    definition { connection – tool (inverse of attaches). }
  }
  made_of {
    definition { concrete item – material (seawater – salt). }
  }
  material_of {
    definition { material – concrete item (inverse of made_of). }
  }
  has_property {
    definition { material – state (air – humidity). }
  }
  property_of {
    definition { state – material (inverse of has_property). }
  }
  owns {
    definition { owner – object (state – enterprise). }
  }
  owned_by {
    definition { object – owner (inverse of owns). }
  }
  ranks_above {
    definition { higher rank – lower rank (chair – vice-chair). }
  }
  ranks_below {
    definition { lower rank – higher rank (inverse of ranks_above). }
  }

  // ── Associative — sequential (ISO 704:2022 §5.5.5 Table 1) ──────
  causes {
    definition { cause – effect (humidity – corrosion). }
  }
  caused_by {
    definition { effect – cause (inverse of causes). }
  }
  develops_into {
    definition { earlier developmental stage – later (tadpole – frog). }
  }
  develops_from {
    definition { later developmental stage – earlier (inverse of develops_into). }
  }

  // ── Associative — activity (ISO 704:2022 §5.5.5 Table 1) ────────
  performed_by {
    definition { action – actor (energy conversion – energy). }
  }
  performs_action {
    definition { actor – action (inverse of performed_by). }
  }
  done_by_method {
    definition { action – method (teach – e-learning). }
  }
  method_of {
    definition { method – action (inverse of done_by_method). }
  }
  done_at {
    definition { action – place (teach – school). }
  }
  place_of_action {
    definition { place – action (inverse of done_at). }
  }
  done_for_purpose {
    definition { action – objective (medical examination – diagnosis). }
  }
  purpose_of_action {
    definition { objective – action (inverse of done_for_purpose). }
  }
  done_for_beneficiary {
    definition { action – beneficiary (hospital discharge – patient). }
  }
  beneficiary_of_action {
    definition { beneficiary – action (inverse of done_for_beneficiary). }
  }
  acts_on_object {
    definition { action – object (learn – school). }
  }
  object_of_action {
    definition { object – action (inverse of acts_on_object). }
  }
  done_with_tool {
    definition { action – instrument (click – computer mouse). }
  }
  tool_of_action {
    definition { instrument – action (inverse of done_with_tool). }
  }
  acts_on_patient {
    definition { action – patient (psychotherapy – client). }
  }
  patient_of_action {
    definition { patient – action (inverse of acts_on_patient). }
  }

  // ── Associative — instrumental (ISO 704:2022 §5.5.5 Table 1) ────
  produces {
    definition { producer – product (baker – bread). }
  }
  produced_by {
    definition { product – producer (inverse of produces). }
  }
  made_from_ingredient {
    definition { raw material – product (wood – desk). }
  }
  ingredient_of {
    definition { product – raw material (inverse of made_from_ingredient). }
  }
  produced_by_instrument {
    definition { tool – product (oven – bread). }
  }
  instrument_product_of {
    definition { product – tool (inverse of produced_by_instrument). }
  }
  employed_by_professional {
    definition { professional – tool employed (painter – brush). }
  }
  employs_tool {
    definition { tool – professional (inverse of employed_by_professional). }
  }
  handled_by_tool {
    definition { object – tool used for handling (time – clock). }
  }
  tool_handles {
    definition { tool – object handled (inverse of handled_by_tool). }
  }
  applied_to_patient {
    definition { tool – patient (baby sling – baby). }
  }
  patient_of_tool {
    definition { patient – tool (inverse of applied_to_patient). }
  }

  // ── Associative — interactional (ISO 704:2022 §5.5.5 Table 1) ───
  controlled_by {
    definition { controlled – controller (pointer – computer mouse). }
  }
  controls {
    definition { controller – controlled (inverse of controlled_by). }
  }
  represented_by {
    definition { entity – representative (length – metre). }
  }
  represents {
    definition { representative – entity (inverse of represented_by). }
  }

  // ── Associative — origination (ISO 704:2022 §5.5.5 Table 1) ─────
  originates_from {
    definition { alias of produces (producer – product). }
  }
  origin_of {
    definition { alias of produced_by. }
  }

  // ── Associative — transmission (ISO 704:2022 §5.5.5 Table 1) ────
  sends_to {
    definition { sender – receiver (satellite – parabolic dish antenna). }
  }
  receives_from {
    definition { receiver – sender (inverse of sends_to). }
  }
  sends_object {
    definition { sender – object sent (mobile phone – text message). }
  }
  object_sent_by {
    definition { object – sender (inverse of sends_object). }
  }

  // ── Associative — opposite (ISO 704:2022 §5.5.5 Table 1) ────────
  opposite_of {
    definition {
      Bidirectional opposite relation (encoding – decoding;
      positive – negative). Single value — symmetric.
    }
  }

  // ── Lexical (ISO 12620 / TBX) ───────────────────────────────────
  homograph {
    definition {
      The related term has the same spelling but a different meaning.
    }
  }
  false_friend {
    definition {
      The related term looks or sounds similar in another language but has a different meaning.
    }
  }

  // ── Register Management (ISO 19135) ─────────────────────────────
  has_concept {
    definition {
      The current register item has the related item as a concept (ISO 19135).
    }
  }
  is_concept_of {
    definition {
      The current item is a concept of the related register item.
    }
  }
  has_definition {
    definition {
      The current concept has the related item as a definition (ISO 19135).
    }
  }
  definition_of {
    definition {
      The current item is a definition of the related concept.
    }
  }
  inherits {
    definition {
      The current concept inherits from the related concept (ISO 19135).
    }
  }
  inherited_by {
    definition {
      The current concept is inherited by the related concept.
    }
  }

  // ── Versioning / Definitional (ISO 19135) ───────────────────────
  has_version {
    definition {
      The current concept has the related concept as a version (ISO 19135).
    }
  }
  version_of {
    definition {
      The current concept is a version of the related concept.
    }
  }
  current_version {
    definition {
      The current concept has the related concept as its current version.
    }
  }
  current_version_of {
    definition {
      The current concept is the current version of the related concept.
    }
  }

  // ── Designation-level (ISO 10241-1) ─────────────────────────────
  abbreviated_form_for {
    definition {
      The current designation is an abbreviated form of the related designation.
    }
  }
  short_form_for {
    definition {
      The current designation is a short form of the related designation.
    }
  }

  // ── ExternalConcept resolution (Glossarist extension) ──────────
  provides {
    definition {
      The current concept provides the substance for an external
      concept (ManagedConcept with status: external). Established
      at the collection level: the collection manager (human or
      auto-resolution routine) who has both datasets loaded adds
      this edge when matching an external concept to its real
      definition.

      Direction: real concept (subject) → external concept (object).
      The inverse is `provided_by`.

      Distinct from supersedes / superseded_by (which replace one
      concept with another). The external concept remains — it is
      still referenced by places that used it; this edge just
      records that its substance now comes from elsewhere.
    }
  }
  provided_by {
    definition {
      The current external concept is provided by the object
      concept — the object concept is its real definition.

      Direction: external concept (subject) → real concept (object).
      The inverse is `provides`.

      Convention: store the edge on the ExternalConcept (in its
      home dataset) rather than on the providing concept. The
      ExternalConcept is the source of truth for its own
      placeholders.
    }
  }
}
