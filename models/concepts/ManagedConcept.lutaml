class ManagedConcept {
  definition {
    A managed term, including its relations with other terms.

    N-ary concept-system relations (PartitiveRelation, GenericRelation)
    live in per-file storage at `relations/<id>/<slug>.yaml`. They are
    NOT declared as a field on ManagedConcept — discovery is by
    directory convention. See docs/design/relations-as-files.md.

    Binary `related` edges remain inline in the concept file.
  }
  +related: RelatedConcept [0..*] {
    definition {
      Binary terms related to the term. Each entry asserts a single
      typed link to one other concept (ISO 10241-1 / SKOS / ISO 25964
      standard semantics).

      For one-to-many partitive or generic decompositions (ISO 704
      rake diagrams), use the per-file n-ary relation format under
      `relations/<id>/`.
    }
  }
  +status: ConceptStatus {
    definition {
      The normative status of the term.
    }
  }
  +dates: ConceptDate [0..*] {
    definition {
      Dates in the lifecycle of the management of the term.
    }
  }
  +sources: ConceptSource [0..*] {
    definition {
      Zero or more bibliographical sources for the term.
    }
  }
  +localizedConcepts: LocalizedConcept [0..1] {
    definition {
      Localisations of the term to different languages.
    }
  }
}
